# KazAI — Environment Variables
# Бұл файлды .env деп атаңыз және GitHub-қа жүктемеңіз!

# OpenRouter API Key (МІНДЕТТІ)
# https://openrouter.ai/keys беттен тегін алыңыз
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace Token (ҚОСЫМША — AI детектор үшін)
# https://huggingface.co/settings/tokens беттен алыңыз
# HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Flask секреттік кілттер (продакшн үшін МІНДЕТТІ түрде өзгертіңіз!)
# Терминалда: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-random-secret-key
JWT_SECRET=change-this-to-random-jwt-secret

# Деплой ортасы
FLASK_ENV=development
FLASK_DEBUG=1

# Render.com деплойда Environment Variables бөлімінде орнатыңыз:
# OPENROUTER_API_KEY, SECRET_KEY, JWT_SECRET
